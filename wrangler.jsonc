{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ieumdc",
  "compatibility_date": "2026-04-02",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "eumdc-production",
      "database_id": "22d53cd8-935e-48f7-827f-2d239c151843"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "eum-dental-images"
    }
  ]
  // NOTE: ADMIN_PASSWORD, AUTH_SECRET은 wrangler pages secret 또는
  // Cloudflare Dashboard > Pages > Settings > Environment variables (Encrypted)로 설정.
  // 로컬 개발은 .dev.vars 파일에서 자동 로드됩니다 (.gitignore됨).
}
